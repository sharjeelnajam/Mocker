<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Bitmap x:Key="MainBackgroundImageSource">avares://MockerProject/Assets/New/Background/bg-gradient.png</Bitmap>
  <ImageBrush x:Key="MainBackgroundImageBrush" Source="avares://MockerProject/Assets/New/Background/bg-gradient.png" Stretch="UniformToFill" />
  
  <Bitmap x:Key="MenuIcon">avares://MockerProject/Assets/New/Icons/menu.png</Bitmap>
  <Bitmap x:Key="NewFileIcon">avares://MockerProject/Assets/New/Icons/file.png</Bitmap>
  <Bitmap x:Key="NewFolderIcon">avares://MockerProject/Assets/New/Icons/folder.png</Bitmap>
  <Bitmap x:Key="StoryBoardIcon">avares://MockerProject/Assets/New/Icons/clipboard.png</Bitmap>
  <Bitmap x:Key="SaveIcon">avares://MockerProject/Assets/New/Icons/save.png</Bitmap>
  <Bitmap x:Key="RulerIcon">avares://MockerProject/Assets/New/Icons/ruler.png</Bitmap>
  <Bitmap x:Key="StylesheetIcon">avares://MockerProject/Assets/New/Icons/colors.png</Bitmap>
  <Bitmap x:Key="SettingsIcon">avares://MockerProject/Assets/New/Icons/setting.png</Bitmap>
  <Bitmap x:Key="UndoIcon">avares://MockerProject/Assets/New/Icons/undo.png</Bitmap>
  <Bitmap x:Key="RedoIcon">avares://MockerProject/Assets/New/Icons/redo.png</Bitmap>
  <Bitmap x:Key="PlayIcon">avares://MockerProject/Assets/New/Icons/play.png</Bitmap>
  <Bitmap x:Key="ShareIcon">avares://MockerProject/Assets/New/Icons/share.png</Bitmap>
  <Bitmap x:Key="SearchIcon">avares://MockerProject/Assets/New/Icons/search.png</Bitmap>

  <Bitmap x:Key="MenuNew">avares://MockerProject/Assets/New/Icons/menunew.png</Bitmap>
  <Bitmap x:Key="MenuOpen">avares://MockerProject/Assets/New/Icons/menuopen.png</Bitmap>
  <Bitmap x:Key="MenuSave">avares://MockerProject/Assets/New/Icons/menusave.png</Bitmap>
  <Bitmap x:Key="MenuSaveAll">avares://MockerProject/Assets/New/Icons/save-all.png</Bitmap>
  <Bitmap x:Key="MenuClose">avares://MockerProject/Assets/New/Icons/x-circle.png</Bitmap>
  <Bitmap x:Key="MenuHelp">avares://MockerProject/Assets/New/Icons/information-circle.png</Bitmap>
  <Bitmap x:Key="MenuAbout">avares://MockerProject/Assets/New/Icons/about.png</Bitmap>

  <Bitmap x:Key="ThreeDotsIcon">avares://MockerProject/Assets/New/Icons/dots.png</Bitmap>
  <Bitmap x:Key="NewProjectIcon">avares://MockerProject/Assets/New/Icons/add-new.png</Bitmap>
  
	<Bitmap x:Key="TreeView">avares://MockerProject/Assets/New/Icons/tree-view.png</Bitmap>
	<Bitmap x:Key="Tabs">avares://MockerProject/Assets/New/Icons/tabs.png</Bitmap>
	<Bitmap x:Key="ContainerBox">avares://MockerProject/Assets/New/Icons/container.png</Bitmap>
	<Bitmap x:Key="Button">avares://MockerProject/Assets/New/Icons/button.png</Bitmap>
	<Bitmap x:Key="TextBox">avares://MockerProject/Assets/New/Icons/text.png</Bitmap>
	<Bitmap x:Key="Label">avares://MockerProject/Assets/New/Icons/text.png</Bitmap>
	<Bitmap x:Key="Title">avares://MockerProject/Assets/New/Icons/title.png</Bitmap>
	<Bitmap x:Key="Link">avares://MockerProject/Assets/New/Icons/link.png</Bitmap>
	<Bitmap x:Key="Password">avares://MockerProject/Assets/New/Icons/password.png</Bitmap>
	<Bitmap x:Key="Check">avares://MockerProject/Assets/New/Icons/checkbox.png</Bitmap>
	<Bitmap x:Key="Image">avares://MockerProject/Assets/New/Icons/image.png</Bitmap>
	<Bitmap x:Key="Radio">avares://MockerProject/Assets/New/Icons/radio.png</Bitmap>
	<Bitmap x:Key="DataPicker">avares://MockerProject/Assets/New/Icons/calender.png</Bitmap>
	<Bitmap x:Key="MultilineButton">avares://MockerProject/Assets/New/Icons/paragraph.png</Bitmap>
	<Bitmap x:Key="TextArea">avares://MockerProject/Assets/New/Icons/text-area.png</Bitmap>
	<Bitmap x:Key="ListBox">avares://MockerProject/Assets/New/Icons/list-box.png</Bitmap>
	<Bitmap x:Key="Repeater">avares://MockerProject/Assets/New/Icons/repeater.png</Bitmap>
	<Bitmap x:Key="DropDown">avares://MockerProject/Assets/New/Icons/dropdown.png</Bitmap>
	<Bitmap x:Key="Table">avares://MockerProject/Assets/New/Icons/table.png</Bitmap>
	<Bitmap x:Key="Slider">avares://MockerProject/Assets/New/Icons/slider.png</Bitmap>
  <Bitmap x:Key="Progress">avares://MockerProject/Assets/New/Icons/progress.png</Bitmap>
  
  <Bitmap x:Key="AddScreen">avares://MockerProject/Assets/New/Icons/add-screen.png</Bitmap>
	
  <Color x:Key="ThemeHeaderBackgroundColor">#FFFFFF</Color>
  <Color x:Key="ThemeControlBackgroundColor">#F3F4F6</Color>
  <Color x:Key="ThemeControlBorderColor">#E5E7EB</Color>
  <Color x:Key="ThemePrimaryTextColor">#111827</Color>
  <Color x:Key="ThemeSecondaryTextColor">#000000</Color>
  <Color x:Key="ThemeControlHoverColor">#E5E7EB</Color>
  <Color x:Key="ThemeControlPressedColor">#D1D5DB</Color>
  <Color x:Key="ThemeRunButtonGradientStart">#6366F1</Color>
  <Color x:Key="ThemeRunButtonGradientEnd">#8B5CF6</Color>
  <Color x:Key="ThemeRunButtonForegroundColor">#FFFFFF</Color>
  <Color x:Key="ThemeDisabledForegroundColor">#9CA3AF</Color>
  <Color x:Key="ThemeMainLeftGradientColor">#3B82F6</Color>
  <Color x:Key="ThemeMainCenterGradientColor">#8B5CF6</Color>
  <Color x:Key="ThemeMainRightGradientColor">#6366F1</Color>
  <Color x:Key="ThemeMenuBorderColor">#E0E0E0</Color>
  <Color x:Key="ThemeDesignStudioGradientStart">#000000</Color>
  <Color x:Key="ThemeDesignStudioGradientEnd">#A855F7</Color>
  <Color x:Key="ThemeDesignStudioBorderBackground">#1F29371A</Color>
  <Color x:Key="ThemeDesignStudioTextColor">#888888</Color>
	<Color x:Key="PlateformBorderColor">#777777</Color>
  <Color x:Key="ThemeSaveProjectGradientStart">#000000</Color>
  <Color x:Key="ThemeSaveProjectGradientEnd">#A855F7</Color>
  <Color x:Key="ThemeSaveButtonGradientStart">#6366F1</Color>
  <Color x:Key="ThemeSaveButtonGradientEnd">#8B5CF6</Color>

  <!-- Animation Timeline Colors for Light Mode -->
  <Color x:Key="ThemeTimelineBackgroundColor">#F9FAFB</Color>
  <Color x:Key="ThemeTimelineBorderColor">#E5E7EB</Color>
  <Color x:Key="ThemeTimelineTextColor">#111827</Color>
  <Color x:Key="ThemeTimelineIconColor">#6B7280</Color>
  <Color x:Key="ThemeTimelineSliderColor">#6366F1</Color>
  <Color x:Key="ThemeTimelineSliderTrackColor">#D1D5DB</Color>

  <SolidColorBrush x:Key="HeaderBackground" Color="{DynamicResource ThemeHeaderBackgroundColor}" />
  <SolidColorBrush x:Key="ControlBackground" Color="{DynamicResource ThemeControlBackgroundColor}" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource ThemeControlBorderColor}" />
  <SolidColorBrush x:Key="PrimaryForeground" Color="{DynamicResource ThemePrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryForeground" Color="{DynamicResource ThemeSecondaryTextColor}" />
  <SolidColorBrush x:Key="ControlHoverBackground" Color="{DynamicResource ThemeControlHoverColor}" />
  <SolidColorBrush x:Key="ControlPressedBackground" Color="{DynamicResource ThemeControlPressedColor}" />
  <SolidColorBrush x:Key="RunButtonForeground" Color="{DynamicResource ThemeRunButtonForegroundColor}" />
  <SolidColorBrush x:Key="DisabledForeground" Color="{DynamicResource ThemeDisabledForegroundColor}" />
  <SolidColorBrush x:Key="MenuBorder" Color="{DynamicResource ThemeMenuBorderColor}" />
	<SolidColorBrush x:Key="PlatformBorderBrush" Color="{DynamicResource PlateformBorderColor}" />

  <!-- Animation Timeline Brushes for Light Mode -->
  <SolidColorBrush x:Key="TimelineBackground" Color="{DynamicResource ThemeTimelineBackgroundColor}" />
  <SolidColorBrush x:Key="TimelineBorder" Color="{DynamicResource ThemeTimelineBorderColor}" />
  <SolidColorBrush x:Key="TimelineText" Color="{DynamicResource ThemeTimelineTextColor}" />
  <SolidColorBrush x:Key="TimelineIcon" Color="{DynamicResource ThemeTimelineIconColor}" />
  <SolidColorBrush x:Key="TimelineSlider" Color="{DynamicResource ThemeTimelineSliderColor}" />
  <SolidColorBrush x:Key="TimelineSliderTrack" Color="{DynamicResource ThemeTimelineSliderTrackColor}" />

  <LinearGradientBrush x:Key="RunButtonBackground" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{DynamicResource ThemeRunButtonGradientStart}" Offset="0.0" />
    <GradientStop Color="{DynamicResource ThemeRunButtonGradientEnd}" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SaveProjectTextForeground" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{DynamicResource ThemeSaveProjectGradientStart}" Offset="0.0" />
    <GradientStop Color="{DynamicResource ThemeSaveProjectGradientEnd}" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SaveProjectButtonBackground" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{DynamicResource ThemeSaveButtonGradientStart}" Offset="0.0" />
    <GradientStop Color="{DynamicResource ThemeSaveButtonGradientEnd}" Offset="1.0" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="DesignStudioGradient" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{DynamicResource ThemeDesignStudioGradientStart}" Offset="0"/>
    <GradientStop Color="{DynamicResource ThemeDesignStudioGradientEnd}" Offset="1"/>
  </LinearGradientBrush>

  <RadialGradientBrush x:Key="LeftRadialGradient" Center="0,0.5" Radius="1.0" Opacity="0.5">
    <GradientStop Color="{DynamicResource ThemeMainLeftGradientColor}" Offset="0" />
    <GradientStop Color="#3B82F600" Offset="1" />
  </RadialGradientBrush>

  <RadialGradientBrush x:Key="CenterRadialGradient" Center="0.5,0.5" Radius="1.0" Opacity="0.5">
    <GradientStop Color="{DynamicResource ThemeMainCenterGradientColor}" Offset="0" />
    <GradientStop Color="#8B5CF600" Offset="1" />
  </RadialGradientBrush>

  <RadialGradientBrush x:Key="RightRadialGradient" Center="1,0.5" Radius="1.0" Opacity="0.5">
    <GradientStop Color="{DynamicResource ThemeMainRightGradientColor}" Offset="0" />
    <GradientStop Color="#6366F100" Offset="1" />
  </RadialGradientBrush>
</ResourceDictionary>