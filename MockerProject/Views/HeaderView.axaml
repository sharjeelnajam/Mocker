					<TextBlock Text="Share" Margin="5 0"  VerticalAlignment="Bottom"></TextBlock>
				</StackPanel>
			</Button>
			<TextBox Name="search" Text="" Watermark="Search" Width="150" Height="20" HorizontalAlignment="Right" Margin="10 5" />

		</StackPanel>
