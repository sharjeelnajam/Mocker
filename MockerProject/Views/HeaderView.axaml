						<Image Source="/Assets/SaveAll.png" Height="20"/>
					</Button>
					<Rectangle Grid.Column="1"  VerticalAlignment="Stretch" Fill="{DynamicResource SystemChromeAltLowColor}" Opacity="0.33" Width="1" Margin="5 ,0,5,0"/>
