<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MockerProject.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MockerProject.Views.SaveProjectWindow"
        Title="Save New Project"
        Icon="/Assets/avalonia-logo.ico"
        Width="500"
        Height="320"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        SystemDecorations="None" Background="Transparent" x:CompileBindings="True" x:DataType="vm:MainWindowViewModel">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Button.GrayButton">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundColor}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextColor}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12 6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Button.SaveButton">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource SaveProjectButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource RunButtonForeground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12 6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.SaveButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeSaveProjectGradientEnd}" />
      <Setter Property="Foreground" Value="{DynamicResource RunButtonForeground}" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource HeaderBackground}" 
          CornerRadius="20" Padding="20" BorderThickness="1"
          BorderBrush="{DynamicResource ControlBorderBrush}">
    <Border.Effect>
      <DropShadowEffect OffsetX="0"
                        OffsetY="24"
                        BlurRadius="48"
                        Color="#0000004D" />
    </Border.Effect>
    <StackPanel Orientation="Vertical" Spacing="20">
      <Border Padding="10 0 10 10" HorizontalAlignment="Stretch">
        <TextBlock Text="Save New Project"
                           Foreground="{DynamicResource SaveProjectTextForeground}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0 15 0 0" FontSize="20"
                           FontWeight="Bold"/>
      </Border>

      <StackPanel Orientation="Vertical" Margin="10">
        <TextBlock Text="Project Name :" Margin="0 0 0 5"
                   Foreground="{DynamicResource PrimaryForeground}" />
        <TextBox Text="{Binding strProjectTitle}"
                 Watermark="Project"
                 HorizontalAlignment="Stretch"
                 Margin="0 0 0 15" />

        <TextBlock Text="Project Path :" Margin="0 0 0 5"
                   Foreground="{DynamicResource PrimaryForeground}" />
        <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 15">
          <Border Grid.Column="0"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="8"
                  Background="{DynamicResource ControlBackground}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Margin="0 0 10 0">
            <TextBlock Text="{Binding strProjectPath}"
                       Foreground="{DynamicResource PrimaryForeground}" />
          </Border>
          <Button Grid.Column="1"
                  Content="Change Project Path" Command="{Binding onSetProjectPath}"
                  Classes="GrayButton" ToolTip.Tip="Change path"
                  VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
          <Button Name="save" Content="Save" Command="{Binding onSave}"
                  Classes="SaveButton" Margin="0 0 10 0" ToolTip.Tip="Save Project" />
          <Button Content="Cancel" Command="{Binding onSaveCancel}"
                  Classes="GrayButton" ToolTip.Tip="Cancel"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>