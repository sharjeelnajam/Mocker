<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.UIControls.CheckControl"
             xmlns:vm="clr-namespace:MockerProject.ViewModels"
             x:CompileBindings="True" x:DataType="vm:UIControlViewModel">

  <UserControl.Styles>

    <Style Selector="CheckBox">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <!-- Checkbox box -->
            <Border Name="checkborder"
                    Width="20" Height="20"
                    CornerRadius="3"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}">
              <!-- Tick (Avalonia default geometry) -->
              <Path x:Name="CheckMark"
                    IsVisible="False"
                    Data="M16.97,4.97 L8,13.94 L4.53,10.47 L3.47,11.53 L8,16.06 L18.03,6.03 Z"
                    Stretch="Uniform"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="Black" />
            </Border>

            <!-- Label -->
            <ContentPresenter Grid.Column="1"
                              Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Show checkmark when checked -->
    <Style Selector="CheckBox:checked /template/ Path#CheckMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Hide checkmark when unchecked -->
    <Style Selector="CheckBox:unchecked /template/ Path#CheckMark">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Remove hover effect -->
    <Style Selector="CheckBox:pointerover /template/ Border#checkborder">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{Binding foreground}" />
    </Style>

    <!-- Remove pressed effect -->
    <Style Selector="CheckBox:pressed /template/ Border#checkborder">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
      <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
    </Style>
    <Style Selector="CheckBox:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{Binding foreground}" />
    </Style>

  </UserControl.Styles>

  <StackPanel Name="check">
    <CheckBox IsChecked="False"
              Content="{Binding text}"
              Width="{Binding width}"
              Height="{Binding height}"
              Opacity="{Binding opacity}"
              ToolTip.Tip="{Binding Control_Tip}"
              Foreground="{Binding foreground}"
              FontSize="{Binding fontSize}"
              FontFamily="{Binding fontFamily}"
              FontWeight="{Binding fontWeight}"
              FontStyle="{Binding fontStyle}"
              Background="{Binding background}"
              BorderBrush="{Binding borderColor}"
              BorderThickness="{Binding borderThickness}"
              CornerRadius="{Binding borderRound}"
              VerticalAlignment="Center" />
  </StackPanel>
</UserControl>