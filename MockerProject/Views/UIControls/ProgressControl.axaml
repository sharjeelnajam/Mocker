<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.UIControls.ProgressControl"
			 xmlns:vm="clr-namespace:MockerProject.ViewModels"
             x:CompileBindings="True" x:DataType="vm:UIControlViewModel">
	<ProgressBar  Margin="0 10" 
                Minimum="0" Maximum="100" Value="{Binding text}"
                Opacity="{Binding opacity}"
                ToolTip.Tip="{Binding Control_Tip}"
                Width="{Binding width}"
                Height="{Binding height}"
                Foreground="{Binding borderColor}"
                Background="{Binding background}"
                ShowProgressText="True"/>
</UserControl>
