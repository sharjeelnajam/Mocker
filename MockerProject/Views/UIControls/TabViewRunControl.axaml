<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.UIControls.TabViewRunControl"
						 xmlns:vm="clr-namespace:MockerProject.ViewModels.UIViewModels;assembly=MockerProject"
						xmlns:v="clr-namespace:MockerProject.Views.UIControls;"
						x:DataType="vm:RepeaterControlViewModel"
						Background="Transparent"
						IsVisible="True">
	<StackPanel Margin="0">
		<TabControl Name="tabControl" ItemsSource="{Binding Items}">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TabItem.Header">
          <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TabItem:selected">
          <Setter Property="Background" Value="White"/>
          <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TabItem:selected /template/ ContentPresenter">
          <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TabItem:pointerover">
          <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter">
          <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="TabControl">
          <Setter Property="Background" Value="White"/>
        </Style>
      </TabControl.Styles>
		</TabControl>
	</StackPanel>
</UserControl>