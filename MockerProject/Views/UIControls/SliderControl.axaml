<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.UIControls.SliderControl"
						 xmlns:vm="clr-namespace:MockerProject.ViewModels"
             x:CompileBindings="True" x:DataType="vm:UIControlViewModel">
  <Slider Name="opical"
					Minimum="0"
					Maximum="100"
					Value="{Binding text}"
					TickFrequency="1"
					ToolTip.Tip="{Binding Control_Tip}"
	        Opacity="{Binding opacity}"
	        IsEnabled="{Binding isEnabled}"
	        Width="{Binding width}"
					Background="{Binding background}"
          Foreground="{Binding borderColor}">
  </Slider>
</UserControl>
