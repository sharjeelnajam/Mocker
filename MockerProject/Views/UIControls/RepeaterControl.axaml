<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.UIControls.RepeaterControl"
			 xmlns:vm="clr-namespace:MockerProject.ViewModels.UIViewModels;assembly=MockerProject"
             x:CompileBindings="True" x:DataType="vm:RepeaterControlViewModel"
			 Background="Transparent"
			 IsVisible="True">
	
	<StackPanel Margin="0">
		<ItemsControl ItemsSource="{Binding Items}" >
		</ItemsControl>
		<Button Name="closeBtn" HorizontalAlignment="Left" Background="Transparent" Foreground="Black"  Command="{Binding AddItems}" >AddItems</Button>

	</StackPanel>
</UserControl>
