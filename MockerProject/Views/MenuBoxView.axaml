<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.MenuBoxView"
             xmlns:vm="clr-namespace:MockerProject.ViewModels"
             x:DataType="vm:MainWindowViewModel" KeyDown="OnKeyDown"
             Focusable="True"
             IsTabStop="True">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid>
    <Border Width="271"
            Height="365"
            CornerRadius="20"
            BorderThickness="1"
            BorderBrush="#E0E0E0" Background="White" Margin="24,75,0,0" HorizontalAlignment="Left"
            VerticalAlignment="Top">
      

      <StackPanel Orientation="Vertical"
                  Spacing="20">
        <TextBlock Text="Project Menu"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#333333"  HorizontalAlignment="Left"
                           Margin="0,0,0,10"/>
        <Button Name="NewBtn"
                        Command="{Binding onNewProject}"
                        HorizontalContentAlignment="Stretch" Background="Transparent"
                        Foreground="#333333">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="/Assets/New/Icons/file-02.png" Height="20" Margin="0,0,15,0"/>
            <TextBlock Grid.Column="1" Text="New" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Ctrl+N" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style Selector="Button:pressed /template/ ContentPresenter">
              <Setter Property="Background" Value="#E5E5E5"/>
            </Style>
          </Button.Styles>
        </Button>

        <Button Name="OpenBtn"
                Command="{Binding onOpenProject}"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Foreground="#333333">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="/Assets/New/Icons/folder-02.png" Height="20" Margin="0,0,15,0"/>
            <TextBlock Grid.Column="1" Text="Open" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Ctrl+O" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style Selector="Button:pressed /template/ ContentPresenter">
              <Setter Property="Background" Value="#E5E5E5"/>
            </Style>
          </Button.Styles>
        </Button>

        <Button Name="SaveBtn"
                Command="{Binding onSaveProject}"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Foreground="#333333">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="/Assets/New/Icons/floppy-disk.png" Height="20" Margin="0,0,15,0"/>
            <TextBlock Grid.Column="1" Text="Save" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Ctrl+S" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style Selector="Button:pressed /template/ ContentPresenter">
              <Setter Property="Background" Value="#E5E5E5"/>
            </Style>
          </Button.Styles>
        </Button>

        <Button Name="SaveAllBtn"
                Command="{Binding onSaveAllProject}"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Foreground="#333333"
                IsEnabled="{Binding IsProjectUnSaved}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="/Assets/New/Icons/save-all.png" Height="20" Margin="0,0,15,0"/>
            <TextBlock Grid.Column="1" Text="Save All" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Ctrl+Shift+S" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style Selector="Button:pressed /template/ ContentPresenter">
              <Setter Property="Background" Value="#E5E5E5"/>
            </Style>
          </Button.Styles>
        </Button>

        <Button Name="CloseBtn"
                Command="{Binding onCloseProject}"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Foreground="#333333">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="/Assets/New/Icons/x-circle.png" Height="20" Margin="0,0,15,0"/>
            <TextBlock Grid.Column="1" Text="Close" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Ctrl+W" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style Selector="Button:pressed /template/ ContentPresenter">
              <Setter Property="Background" Value="#E5E5E5"/>
            </Style>
          </Button.Styles>
        </Button>

        <Button Name="HelpBtn"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Foreground="#333333">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="/Assets/New/Icons/information-circle.png" Height="20" Margin="0,0,15,0"/>
            <TextBlock Grid.Column="1" Text="Help" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style Selector="Button:pressed /template/ ContentPresenter">
              <Setter Property="Background" Value="#E5E5E5"/>
            </Style>
          </Button.Styles>
        </Button>

        <Button Name="AboutBtn"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Foreground="#333333">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="/Assets/New/Icons/about.png" Height="20" Margin="0,0,15,0"/>
            <TextBlock Grid.Column="1" Text="About" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style Selector="Button:pressed /template/ ContentPresenter">
              <Setter Property="Background" Value="#E5E5E5"/>
            </Style>
          </Button.Styles>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>