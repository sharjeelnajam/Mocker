<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MockerProject.ViewModels"
             xmlns:v="clr-namespace:MockerProject.Views"
             Name="ProjectTaskbar"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.ProjectTaskbarView"
             x:DataType="vm:MainWindowViewModel">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="ToggleButton:checked">
      <Setter Property="Background" Value="Red"/>
    </Style>
    <Style Selector="Button.TransparentButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
    </Style>
    <Style Selector="Button.TransparentButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeControlHoverColor}"/>
    </Style>
    <Style Selector="Button.TransparentButton:pressed">
      <Setter Property="Background" Value="{DynamicResource ThemeControlPressedColor}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource HeaderBackground}" Margin="1">    
    <StackPanel DockPanel.Dock="Top">
      <Grid ColumnDefinitions="*,Auto" Margin="5 5 5 0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock Text="{Binding strProjectTitle}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     FontSize="16"
                     FontWeight="Bold" 
                     Name="Project"/>
          <TextBlock Text="*"
                     IsVisible="{Binding IsProjectUnSaved}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     FontSize="16"
                     FontWeight="Bold"
                     Margin="2 0 0 0"/>
        </StackPanel>

        <Button Grid.Column="1" Command="{Binding onNewScreen}" Classes="TransparentButton"
                VerticalAlignment="Center" HorizontalAlignment="Right"
                Width="24" Height="24" Padding="0">
          <Image Source="{DynamicResource AddScreen}" Width="16" Height="16" />
        </Button>
      </Grid>

      <Separator IsEnabled="False"
                 Background="{DynamicResource SystemChromeAltLowColor}"
                 Opacity="0.3">
      </Separator>
    </StackPanel>

    <DockPanel>
      <DockPanel.ContextMenu>
        <ContextMenu>
          <MenuItem Header="New Screen" Command="{Binding onNewScreen}"/>
          <MenuItem Header="Delete" Command="{Binding onDeleteScreen}"/>
          <MenuItem Header="Rename"/>
        </ContextMenu>
      </DockPanel.ContextMenu>

      <ListBox Name="ListSmallScreen" SelectedIndex="{Binding SmallScreenID}"
               ItemsSource="{Binding SmallScreens}" Background="Transparent" IsVisible="{Binding IsScreenVisible}">
        <!--<ListBox.ItemTemplate>
           <DataTemplate>
               <ContentControl Content="{Binding}"></ContentControl>
           </DataTemplate>
         </ListBox.ItemTemplate>-->
      </ListBox>

      <!--<ListBox Name="myList" SelectedIndex="{Binding MyItemsIndex}">
          <ListBoxItem >
              <Panel>
                  <v:ScreenSmallView></v:ScreenSmallView>
                  <TextBlock TextAlignment="Center" Text="SCREEN 1"></TextBlock>
              </Panel>
          </ListBoxItem>
      </ListBox>-->
    </DockPanel>
  </DockPanel>

</UserControl>