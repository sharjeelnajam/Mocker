<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MockerProject.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.ProjectWorkView"
             x:CompileBindings="True" x:DataType="vm:MainWindowViewModel">
    
    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable Content Area -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top">
                <ContentControl Content="{Binding WorkScreen}"  Name="Screen"></ContentControl>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Fixed Animation Timeline Bar -->
        <Border Grid.Row="1" 
                Background="{DynamicResource TimelineBackground}"
                BorderBrush="{DynamicResource TimelineBorder}"
                BorderThickness="0,1,0,0"
                Height="48"
                Padding="16 0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- ANIMATION TIMELINE Text -->
                <TextBlock Grid.Column="0" 
                           Text="ANIMATION TIMELINE"
                           Foreground="{DynamicResource TimelineText}"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                
                <!-- Camera Icon -->
                <Button Grid.Column="1" 
                        Margin="24 0 0 0"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="24" Height="24"
                        Padding="0">
                    <Image Source="{DynamicResource Image}" Width="20" Height="20" />
                </Button>
                
                <!-- Document Icon -->
                <Button Grid.Column="2" 
                        HorizontalAlignment="Left"
                        Margin="16 0 0 0"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="24" Height="24"
                        Padding="0">
                    <Image Source="{DynamicResource NewFileIcon}" Width="20" Height="20" />
                </Button>
                
                <!-- Zoom Slider -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <Slider Width="120" 
                            Minimum="0" 
                            Maximum="100" 
                            Value="50"
                            Foreground="{DynamicResource TimelineSlider}"
                            Background="{DynamicResource TimelineSliderTrack}"/>
                    <TextBlock Text="+ 10%" 
                               Foreground="{DynamicResource TimelineText}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- More Options Icon -->
                <Button Grid.Column="4" 
                        Margin="16 0 0 0"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="24" Height="24"
                        Padding="0">
                    <Image Source="{DynamicResource ThreeDotsIcon}" Width="20" Height="20" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
