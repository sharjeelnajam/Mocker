<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MockerProject.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.ProjectWorkView"
             x:CompileBindings="True" x:DataType="vm:MainWindowViewModel">
    
    <Grid RowDefinitions="*,Auto">
        <!-- Notification Popup -->
        <Border Name="NotificationPopup"
                Grid.Row="0"
                Background="White"
                BorderBrush="LightBlue"
                BorderThickness="1"
                CornerRadius="4"
                Width="250"
                Height="80"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20,20,20,0"
                IsVisible="False"
                ZIndex="1000">
            <Grid RowDefinitions="Auto,*">
                <!-- Header with close button -->
                <Border Grid.Row="0" 
                        Background="LightBlue" 
                        Height="25" 
                        CornerRadius="4,4,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="Screenshot Captured" 
                                   Foreground="Black" 
                                   FontSize="10" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <Button Grid.Column="1" 
                                Name="CloseNotificationButton"
                                Background="#FFE0E0"
                                BorderThickness="1"
                                BorderBrush="Red"
                                Width="24" 
                                Height="24"
                                Margin="0,0,2,0"
                                Click="OnCloseNotificationClick">
                            <TextBlock Text="✕" 
                                       Foreground="Red" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Content -->
                <StackPanel Grid.Row="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Margin="10">
                    <TextBlock Text="Image captured!" 
                               Foreground="DarkGray" 
                               FontSize="12" 
                               VerticalAlignment="Center"/>
                    <Button Name="OpenFolderButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="10,0,0,0"
                            Click="OnOpenFolderClick">
                        <TextBlock Text="Open folder" 
                                   Foreground="DarkGray" 
                                   FontSize="12" 
                                   TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Full Screen Flash Overlay -->
        <Border Name="FlashOverlay"
                Grid.Row="0"
                Background="White"
                Opacity="0"
                IsVisible="False"
                ZIndex="999">
        </Border>
        
        <!-- Scrollable Content Area -->
        <ScrollViewer Name="WorkScroll" Grid.Row="0" HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top">
                <ContentControl Content="{Binding WorkScreen}"  Name="Screen"></ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Ruler overlay (top and left) -->
        <Canvas Name="RulerOverlay" Grid.Row="0" ZIndex="900" IsHitTestVisible="False" IsVisible="{Binding IsRulerVisible}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top ruler -->
            <Canvas Name="TopRuler" Height="24" Background="#33000000"/>
            <!-- Left ruler -->
            <Canvas Name="LeftRuler" Width="24" Background="#33000000"/>
            <!-- Guides -->
            <Line Name="GuideV" Stroke="#CCFF00FF" StrokeThickness="1" IsVisible="False"/>
            <Line Name="GuideH" Stroke="#CCFF00FF" StrokeThickness="1" IsVisible="False"/>
            <!-- Measurement display -->
            <Border Name="MeasurementDisplay" Background="#CCFF00FF" CornerRadius="3" Padding="4,2" IsVisible="False">
                <TextBlock Name="MeasurementText" Text="0, 0" Foreground="White" FontSize="10" FontWeight="Bold"/>
            </Border>
        </Canvas>
        
        <!-- Fixed Animation Timeline Bar -->
        <Border Grid.Row="1" 
                Background="{DynamicResource TimelineBackground}"
                BorderBrush="{DynamicResource TimelineBorder}"
                BorderThickness="0,1,0,0"
                Height="48"
                Padding="16 0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- ANIMATION TIMELINE Text -->
                <TextBlock Grid.Column="0" 
                           Text="ANIMATION TIMELINE"
                           Foreground="{DynamicResource TimelineText}"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                
            
                
                <!-- Camera and Document Icons (Moved to Right Side) -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <!-- Camera Icon -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Width="24" Height="24"
                            Padding="0"
                            Click="OnCameraButtonClick"
                            ToolTip.Tip="Take snapshot (Ctrl + R)">
                        <Image Source="{DynamicResource Camera}" Width="20" Height="20" />
                    </Button>
                    

                    <!-- Ruler Toggle Button -->
                    <ToggleButton Background="Transparent"
                            BorderThickness="0"
                            Width="24" Height="24"
                            Padding="0"
                            IsChecked="{Binding IsRulerVisible}"
                            ToolTip.Tip="Show rulers and guides (Ctrl + L)">
                        <Image Source="{DynamicResource Ruler}" Width="20" Height="20" />
                    </ToggleButton>

					<!-- Document Icon -->
					<Button Background="Transparent"
                            BorderThickness="0"
                            Width="24" Height="24"
                            Padding="0"
                            Click="OnCenterScreenClick"
                            ToolTip.Tip="100%">
						<Image Source="{DynamicResource Center}" Width="20" Height="20" />
					</Button>
					
                    <!-- Zoom Slider -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                                            <Slider Width="120" 
                            Minimum="1" 
                            Maximum="100" 
                            Value="{Binding ZoomPercent, Mode=TwoWay}"
                            Foreground="{DynamicResource TimelineSlider}"
                            Background="{DynamicResource TimelineSliderTrack}"/>
                                            <TextBlock Text="{Binding ZoomPercent, StringFormat='+ {0}%'}" 
                               Foreground="{DynamicResource TimelineText}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    </StackPanel>
                    
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
