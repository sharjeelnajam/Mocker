<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MockerProject.Views.UIProperties.UIContainerBoxProperty"
		    xmlns:vm="clr-namespace:MockerProject.ViewModels"
		    xmlns:v="clr-namespace:MockerProject.Views.UIProperties"
        x:CompileBindings="True"
		    SizeToContent="WidthAndHeight"
		    x:DataType="vm:UIControlViewModel"
		    Title="{Binding Control_Name}"
		    CanResize="False"
		    ShowInTaskbar="False"
		    Opacity="0.95" Background="{DynamicResource ThemeDesignStudioBorderBackground}" FontSize="12">
  <StackPanel Orientation="Vertical">
    <v:UIPropertyBase Name="BaseProperty"/>
  </StackPanel>
</Window>