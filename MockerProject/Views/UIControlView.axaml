<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.UIControlView" Background="{DynamicResource HeaderBackground}" Margin="5">

  <UserControl.Styles>
    <Style Selector="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeDesignStudioBorderBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Border:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Auto"
              Background="{DynamicResource HeaderBackground}"
              VerticalScrollBarVisibility="Auto">

    <StackPanel Orientation="Vertical" Margin="0 5 0 0">

      <!-- Row 1 -->
      <UniformGrid Columns="3" Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="TreeView" Source="{DynamicResource TreeView}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Tree View" Foreground="{DynamicResource PrimaryForeground}"
                     FontFamily="Inter" FontWeight="Medium" FontSize="14"
                     TextAlignment="Center" HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Tabs" Source="{DynamicResource Tabs}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Tabs" Foreground="{DynamicResource PrimaryForeground}"
                     FontFamily="Inter" FontWeight="Medium" FontSize="14"
                     TextAlignment="Center" HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="ContainerBox" Source="{DynamicResource ContainerBox}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Container" Foreground="{DynamicResource PrimaryForeground}"
                     FontFamily="Inter" FontWeight="Medium" FontSize="14"
                     TextAlignment="Center" HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>
      </UniformGrid>

      <Separator Background="{DynamicResource ThemeDesignStudioBorderBackground}" Height="1" Margin="0,10"/>

      <!-- Row 2 -->
      <UniformGrid Columns="3" Margin="10">
        <!-- Button -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Button" Source="{DynamicResource Button}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Button" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <!-- TextBox -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="TextBox" Source="{DynamicResource TextBox}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="TextBox" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <!-- Label -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Label" Source="{DynamicResource Label}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Label" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>
      </UniformGrid>

      <!-- Row 3 -->
      <UniformGrid Columns="3" Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Title" Source="{DynamicResource Title}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Title" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Link" Source="{DynamicResource Link}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Link" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Password" Source="{DynamicResource Password}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Password" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>
      </UniformGrid>

      <!-- Row 4 -->
      <UniformGrid Columns="3" Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Check" Source="{DynamicResource Check}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Check" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Image" Source="{DynamicResource Image}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Image" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Radio" Source="{DynamicResource Radio}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Radio" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>
      </UniformGrid>

      <!-- Row 5 -->
      <UniformGrid Columns="3" Margin="10">
        <!--<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="DataPicker" Source="{DynamicResource DataPicker}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="DataPicker" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>-->

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="MultilineButton" Source="{DynamicResource MultilineButton}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="MultilineBtn" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="TextArea" Source="{DynamicResource TextArea}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="TextArea" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="listBox" Source="{DynamicResource ListBox}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="listBox" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>
      </UniformGrid>

      <!-- Row 6 -->
      <UniformGrid Columns="3" Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Repeater" Source="{DynamicResource Repeater}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Repeater" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="DropDown" Source="{DynamicResource DropDown}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="DropDown" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Slider" Source="{DynamicResource Slider}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Slider" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>
      </UniformGrid>

      <!-- Row 7 -->
      <UniformGrid Columns="3" Margin="10">
        <!--<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Table" Source="{DynamicResource Table}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Table" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>-->       

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="52" Height="52" Padding="12" HorizontalAlignment="Center">
            <Image Name="Progress" Source="{DynamicResource Progress}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Progress" Foreground="{DynamicResource PrimaryForeground}" FontFamily="Inter"
                     FontWeight="Medium" FontSize="14" TextAlignment="Center"
                     HorizontalAlignment="Center" Padding="5"/>
        </StackPanel>
        <StackPanel />
        <StackPanel />
      </UniformGrid>

    </StackPanel>
  </ScrollViewer>

</UserControl>