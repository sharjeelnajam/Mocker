<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MockerProject.Views.UIControlView" Background="#505050" Margin="5">
    <UserControl.Styles>
        <Style Selector="Border:pointerover">
            <Setter Property="BorderBrush" Value="#777777"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>
    
    <ScrollViewer HorizontalScrollBarVisibility="Auto" Background="White"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="5">
			<DockPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="TreeView" Source="/Assets/UIControls/tree.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Border>
					<TextBlock Text="Tree View"
							   Foreground="#1F2937"
							   FontFamily="Inter"
							   FontWeight="Medium"
							   FontSize="14"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   Padding="5"
							   Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Tabs" Source="/Assets/UIControls/Tabs.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Border>
					<TextBlock Text="Tabs"
							   Foreground="#1F2937"
							   FontFamily="Inter"
							   FontWeight="Medium"
							   FontSize="14"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   Padding="5"
							   Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="ContainerBox" Source="/Assets/UIControls/Container.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Border>
					<TextBlock Text="Container"
							   Foreground="#1F2937"
							   FontFamily="Inter"
							   FontWeight="Medium"
							   FontSize="14"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   Padding="5"
							   Margin="0"/>
				</StackPanel>
			</DockPanel>
			<Separator Background="#E8E9EA" Height="1" Margin="0,10"/>
			<DockPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Button" Source="/Assets/UIControls/Button.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Button" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="TextBox" Source="/Assets/UIControls/TextField.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="TextBox" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Label" Source="/Assets/UIControls/Label.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Label" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>
			</DockPanel>

			<DockPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Title" Source="/Assets/UIControls/Title.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Title" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Link" Source="/Assets/UIControls/Link.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Link" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Password" Source="/Assets/UIControls/Password.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Password" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>
			</DockPanel>

			<DockPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Check" Source="/Assets/UIControls/Check.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Check" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Image" Source="/Assets/UIControls/Image.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Image" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Radio" Source="/Assets/UIControls/Radio.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Radio" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>
			</DockPanel>

			<DockPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="DataPicker" Source="/Assets/UIControls/DataPicker.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="DataPicker" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="MultilineButton" Source="/Assets/UIControls/MultilineButton.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Multiline Button" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="TextArea" Source="/Assets/UIControls/TextArea.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="TextArea" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>
			</DockPanel>

			<DockPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="listBox" Source="/Assets/UIControls/ListBox.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="ListBox" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Repeater" Source="/Assets/UIControls/Repeater.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Repeater" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="DropDown" Source="/Assets/UIControls/DropDown.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="DropDown" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>
			</DockPanel>

			<DockPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Table" Source="/Assets/UIControls/Table.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Table" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Slider" Source="/Assets/UIControls/Slider.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Slider" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>

				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
					<Border Width="52" Height="52" Background="#E8E9EA" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
						<Image Name="Progress" Source="/Assets/UIControls/Progress.png" Stretch="Uniform" />
					</Border>
					<TextBlock Text="Progress" Foreground="#1F2937" FontFamily="Inter" FontWeight="Medium" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Padding="5" Margin="0"/>
				</StackPanel>
			</DockPanel>

		</StackPanel>
    </ScrollViewer>
</UserControl>
